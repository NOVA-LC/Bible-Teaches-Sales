# Copy this file to `.env` (in this same directory) after rotating your key.
# .env is gitignored; .env.example is committed as the template.
#
# Get a key: https://console.anthropic.com/ → API Keys → Create Key
# Cost: each weekly article run ≈ a few dollars depending on retries.

ANTHROPIC_API_KEY=sk-ant-api03-PASTE_YOUR_ROTATED_KEY_HERE

# Optional — pin model and max tokens (defaults shown)
# ANTHROPIC_MODEL=claude-opus-4-7
# ANTHROPIC_MAX_TOKENS=2048

# Optional — Resend (for emailing the final .jwlibrary)
# RESEND_API_KEY=re_PASTE_HERE
# RESEND_FROM=Tyler <tyler@gonenova.com>
# RESEND_TO=tylerjavonbrown@gmail.com
